    "conditions": [
      "identity",
      "rotation",
      "reflection",
      "translation",
      "orthogonal_translation",
      "gaussian_0p010",
      "gaussian_0p050",
      "gaussian_0p100",
      "laplacian_0p010",
      "laplacian_0p050",
      "laplacian_0p100"
    ],
    "graph_kind": "raw_level0",
    "within_subset_variant": "practical_repair",
    "require_raw_no_repair_graph": true
  },
  "methods": {
    "enabled": [
      "bruteforce_ground_truth",
      "full_rebuild_hnsw",
      "dual_index",
      "no_cross_merged",
      "random_cross_links",
      "sampled_cross_knn",
      "incremental_insertion"
    ],
    "first_round": [
      "bruteforce_ground_truth",
      "full_rebuild_hnsw",
      "dual_index",
      "no_cross_merged",
      "random_cross_links",
      "sampled_cross_knn",
      "incremental_insertion"
    ],
    "second_round_planned": [
      "anchor_pseudo_anchor_cross_links",
      "join_set_propagation_merge",
      "raw_level0_vs_query_derived_ablation",
      "no_repair_vs_practical_repair_ablation"
